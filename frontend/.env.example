# Vercel Deployment Configuration
# Set this environment variable in your Vercel Project Settings > Environment Variables
# Example with ngrok: https://xxxx-xx-xx-xx-xx.ngrok-free.app
# Example with Cloudflare Tunnel: https://xxxx.trycloudflare.com
# Example with Localtunnel: https://xxxx.loca.lt
# When left empty during local development, Vite proxies '/api' directly to http://127.0.0.1:8000
VITE_API_BASE_URL=
